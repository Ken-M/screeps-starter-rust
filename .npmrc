# サプライチェーン攻撃対策 (このファイルは git 管理対象。認証トークンは絶対に書かない)
#
# ignore-scripts: 依存パッケージの preinstall/install/postinstall を実行しない。
#   npm の侵害パッケージ (Shai-Hulud 等) はインストールスクリプトで自己増殖するため、
#   ここを塞ぐのが最も効果の高い一手。rollup v4 のネイティブバイナリは
#   optionalDependencies の @rollup/rollup-<platform> パッケージが担うのでスクリプト不要。
#   将来スクリプトが必要な依存が増えたら `npm rebuild <pkg>` を明示実行する。
#
# min-release-age: 公開から N 日経過したバージョンのみインストール対象にする (cooldown)。
#   侵害パッケージは公開後 数時間〜数日で検知・削除されるため、寝かせるだけで大半を回避できる。
#   緊急のセキュリティパッチを即入れたいときだけ `npm i <pkg> --min-release-age=0` で個別に外す。
#
# audit: install のたびに既知脆弱性を照会する。
ignore-scripts=true
min-release-age=7
audit=true
fund=false

# レジストリ (TakumiGuard) と認証トークンはユーザーの ~/.npmrc 側で設定する。
# registry=https://npm.flatt.tech/
